#!/usr/bin/env bash
# check_chrony v0.2 — Icinga2/Nagios plugin for Chrony NTP/PTP offset
# https://github.com/0kaba0hub/check_chrony

CHRONY_DAEMON="chronyd"
LEAP_OK="Normal"
debug=false

help() {
  cat <<EOF
Usage: check_chrony [options]
    -w [warning threshold in seconds]
    -c [critical threshold in seconds]
    --debug        Enable debug output
    e.g.: check_chrony -w 0.6 -c 2 --debug
EOF
  exit 3
}

exit_with_status() {
  local status=$1
  local message=$2
  local states=("OK" "WARNING" "CRITICAL" "UNKNOWN")
  echo "${states[$status]}: $message"
  exit "$status"
}

[[ $# -eq 0 ]] && help

while [[ $# -gt 0 ]]; do
  case "$1" in
    -w)      warning="$2";  shift 2 ;;
    -c)      critical="$2"; shift 2 ;;
    --debug) debug=true;    shift   ;;
    *)       help ;;
  esac
done

if ! [[ "$warning" =~ ^[0-9]+(\.[0-9]+)?$ ]] || ! [[ "$critical" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
  exit_with_status 3 "Value of option -w or -c is not a valid number!"
fi

if ! pgrep -x "$CHRONY_DAEMON" > /dev/null; then
  exit_with_status 2 "$CHRONY_DAEMON is not running!"
fi

if ! chrony_output=$(chronyc tracking 2>/dev/null); then
  exit_with_status 3 "Chronyc tracking command failed!"
fi

if [[ $debug == true ]]; then
  echo "DEBUG: chrony_output:"
  echo "$chrony_output"
fi

# "System time" line format: "System time     :  0.000046626 seconds slow of NTP time"
offset=$(echo "$chrony_output" | awk '/System time/ {print $4}')
dir=$(echo "$chrony_output"    | awk '/System time/ {print $5}')
leap=$(echo "$chrony_output"   | awk -F': ' '/Leap status/ {print $2}')

if [[ $debug == true ]]; then
  echo "DEBUG: offset='$offset', direction='$dir', leap='$leap'"
fi

if [[ -z "$offset" || -z "$dir" ]]; then
  exit_with_status 3 "Failed to parse offset or direction from chronyc output!"
fi

# Compare absolute offset against thresholds, then apply sign for display
if (( $(echo "$offset >= $critical" | bc -l) )); then
  rc=2
elif (( $(echo "$offset >= $warning" | bc -l) )); then
  rc=1
else
  rc=0
fi

# "slow" means the system clock is behind (negative offset)
if [[ "$dir" == "slow" ]]; then
  offset="-$offset"
else
  offset="+$offset"
fi

msg=$(printf "Time offset of %+.9f seconds to reference." "$offset")
perfdata=$(printf "|offset=%.9fs;%.9f;%.9f" "$offset" "$warning" "$critical")

if [[ "$leap" != "$LEAP_OK" ]]; then
  exit_with_status 2 "Chrony leap status \"$leap\" is not equal to \"$LEAP_OK\"! $msg $perfdata"
fi

exit_with_status $rc "$msg $perfdata"
